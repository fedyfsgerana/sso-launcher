ASPNETCORE_ENVIRONMENT=Development
ASPNETCORE_URLS=http://localhost:5000

ConnectionStrings__PostgreSql=Host=localhost;Port=5432;Database=sso_launcher;Username=postgres;Password=change-me

Session__LifetimeHours=8

SsoToken__Issuer=sso-launcher
SsoToken__SigningKey=replace-with-a-random-secret-at-least-32-bytes
SsoToken__LifetimeSeconds=60

ServiceAccessToken__Issuer=sso-launcher
ServiceAccessToken__SigningKey=replace-with-a-random-secret-at-least-32-bytes
ServiceAccessToken__LifetimeSeconds=300

Cors__AllowedOrigins__0=http://localhost:3000
