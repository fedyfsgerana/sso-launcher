<Project Sdk="Microsoft.NET.Sdk.Web">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
        <DefaultItemExcludes>
            $(DefaultItemExcludes);src\**;tests\**
        </DefaultItemExcludes>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="ClosedXML" Version="0.105.1" />
        <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.14" />
        <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.14">
            <PrivateAssets>all</PrivateAssets>
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        </PackageReference>
        <PackageReference Include="Scalar.AspNetCore" Version="2.18.5" />
    </ItemGroup>

    <ItemGroup>
        <EmbeddedResource Include="..\..\docs\SSO-INTEGRATION.md" LogicalName="sso-integration-guide.md" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="src\SsoLauncher.Application\SsoLauncher.Application.csproj" />
        <ProjectReference Include="src\SsoLauncher.Domain\SsoLauncher.Domain.csproj" />
        <ProjectReference Include="src\SsoLauncher.Infrastructure\SsoLauncher.Infrastructure.csproj" />
    </ItemGroup>

</Project>
